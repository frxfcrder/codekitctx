# CodeKitCtx environment configuration
# Copy to .env and adjust. NEVER commit .env.

# API key for /compile* endpoints.
# - Leave empty for localhost-only dev (unauthenticated, warning logged).
# - REQUIRED when binding to a non-loopback host (server refuses to start without it).
CODEKITCTX_API_KEY=

# Semicolon-separated list of allowed repository roots (path allowlist).
# The API rejects repo_path and files resolving outside these roots.
# Default (empty) = current working directory only.
# Example: CODEKITCTX_ALLOWED_ROOTS=C:\projects;D:\repos;/home/user/workspace
CODEKITCTX_ALLOWED_ROOTS=

# Comma-separated CORS origins for browser access (React dev server etc).
# Default: http://localhost:5173,http://127.0.0.1:5173
# Wildcards are ignored and replaced with the localhost defaults.
CODEKITCTX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Safe mode (default: on = 1).
# When on: allow_sensitive forced off via API, symlink/traversal checks active.
# Set to 0 only for trusted local use.
CODEKITCTX_SAFE_MODE=1

# Comma-separated allowed Host headers (TrustedHostMiddleware).
# Default: localhost,127.0.0.1,testserver
# Set this when deploying under a real hostname.
CODEKITCTX_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Uvicorn bind host — fallback for the startup security check only.
# The real bind host is resolved from uvicorn LifespanOn.config or `--host`
# (CLI flag wins over this env). Keep 127.0.0.1 for local dev.
# Non-loopback + no API key = refuses to start.
UVICORN_HOST=127.0.0.1

# Legacy/optional defaults (CLI/library)
REPOCTX_DEFAULT_PATH=.
REPOCTX_ALLOW_SENSITIVE=false
REPOCTX_MAX_SIZE=1048576
